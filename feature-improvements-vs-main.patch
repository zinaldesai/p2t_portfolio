-* {
+@font-face {
+  font-family: "RocaTwo";
+  src:
+    url("../assets/font/roca/RocaTwo-Bold.woff2") format("woff2"),
+    url("../assets/font/roca/RocaTwo-Bold.woff") format("woff");
+  font-weight: bold;
+  font-style: normal;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: "Decalotype-Regular";
+  src: url("../assets/font/Decalotype-Regular.woff") format("woff");
+  font-weight: normal;
+  font-style: normal;
+  font-display: swap;
+}
+
+:root {
+  --color-bg-primary: #fafafa;
+  --color-bg-secondary: #f0f0f3;
+  --color-bg-card: rgba(255, 255, 255, 0.72);
+  --color-text-primary: #1a1a2e;
+  --color-text-secondary: #4a4a5c;
+  --color-text-muted: #6b6b7a;
+  --color-accent: #6366f1;
+  --color-accent-hover: #818cf8;
+  --color-accent-glow: rgba(99, 102, 241, 0.35);
+  --color-accent-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
+  --color-border: rgba(0, 0, 0, 0.08);
+  --color-nav-bg: rgba(250, 250, 250, 0.78);
+  --color-card-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
+  --font-heading: "RocaTwo", system-ui, sans-serif;
+  --font-body: "Decalotype-Regular", system-ui, sans-serif;
+}
+
+body.dark-mode {
+  --color-bg-primary: #0a0a0f;
+  --color-bg-secondary: #12121a;
+  --color-bg-card: rgba(20, 20, 32, 0.55);
+  --color-text-primary: #f0f0f5;
+  --color-text-secondary: #b8b8c8;
+  --color-text-muted: #7a7a8c;
+  --color-accent: #818cf8;
+  --color-accent-hover: #a5b4fc;
+  --color-accent-glow: rgba(129, 140, 248, 0.25);
+  --color-accent-gradient: linear-gradient(135deg, #6366f1 0%, #a78bfa 100%);
+  --color-border: rgba(255, 255, 255, 0.08);
+  --color-nav-bg: rgba(10, 10, 15, 0.72);
+  --color-card-shadow: 0 4px 32px rgba(0, 0, 0, 0.35);
+}
+
+*,
+*::before,
+*::after {
   box-sizing: border-box;
 }
 
-body, html {
+html {
+  scroll-behavior: smooth;
+}
+
+body,
+html {
   margin: 0;
   padding: 0;
   overflow-x: hidden;
 }
+
+body {
+  font-family: var(--font-body);
+  background-color: var(--color-bg-primary);
+  color: var(--color-text-primary);
+  transition:
+    background-color 0.4s ease,
+    color 0.4s ease;
+}
+
+#root {
+  min-height: 100vh;
+}
+
 .content-container {
-  width: 100vw;
-  height: 100vh;
+  width: 100%;
+  min-height: 100vh;
   overflow-y: auto;
   overflow-x: hidden;
-  padding: 5;
   display: flex;
   flex-direction: column;
+  background-color: var(--color-bg-primary);
+  transition: background-color 0.4s ease;
+}
+
+/* Focus visibility for keyboard users */
+:focus-visible {
+  outline: 2px solid var(--color-accent);
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+}
+
+/* Legacy font utility classes (Tailwind font-heading/body preferred) */
+.font-decalotype {
+  font-family: var(--font-body);
+}
+
+.font-roca {
+  font-family: var(--font-heading);
+}
+
+@import "../Toggle/style.css";
+
+/* Dot grid background pattern */
+.dot-grid {
+  background-image: radial-gradient(
+    circle,
+    var(--color-text-muted) 0.6px,
+    transparent 0.6px
+  );
+  background-size: 28px 28px;
+  opacity: 0.18;
+}
+
+/* Shimmer border effect for cards */
+.shimmer-border {
+  position: relative;
+  overflow: hidden;
+}
+.shimmer-border::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  padding: 1px;
+  background: linear-gradient(
+    90deg,
+    transparent 0%,
+    var(--color-accent) 50%,
+    transparent 100%
+  );
+  background-size: 200% 100%;
+  animation: shimmer 2.5s ease-in-out infinite;
+  mask:
+    linear-gradient(#fff 0 0) content-box,
+    linear-gradient(#fff 0 0);
+  mask-composite: exclude;
+  -webkit-mask:
+    linear-gradient(#fff 0 0) content-box,
+    linear-gradient(#fff 0 0);
+  -webkit-mask-composite: xor;
+  pointer-events: none;
+  opacity: 0;
+  transition: opacity 0.3s ease;
+}
+.shimmer-border:hover::before {
+  opacity: 1;
+}
+
+@keyframes shimmer {
+  0% { background-position: -200% 0; }
+  100% { background-position: 200% 0; }
 }
